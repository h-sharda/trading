// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String
  passwordHash             String
  kiteApiKey               String?
  kiteApiSecret            String?
  kiteAccessToken          String?
  kiteAccessTokenExpiresAt DateTime?
  cdslTpin                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  sessions                 Session[]
  scheduledOrders          ScheduledOrder[]
}

enum ScheduledOrderStatus {
  pending
  armed
  placed
  failed
  cancelled
}

model ScheduledOrder {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange        String
  tradingsymbol   String
  quantity        Int
  product         String               @default("CNC")
  transactionType String               @default("SELL")
  orderType       String               @default("MARKET")
  executeAt       DateTime
  status          ScheduledOrderStatus @default(pending)
  orderTag        String?
  kiteOrderId     String?
  errorMessage    String?
  placedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, executeAt])
  @@index([userId, status])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
